{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdof-foundation-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-15",
  "d1_databases": [
    {
      "binding": "GDOF_DB",
      "database_name": "gdof-admin-db",
      "database_id": "9aefe29e-2bdc-465f-8417-fa7350d2370e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GDOF_MEDIA",
      "bucket_name": "gdof-media"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
